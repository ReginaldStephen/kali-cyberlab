app.get(
  "/api/python/telemetry",
  async (_req, res) => {
    try {
      const pyResult =
        await runShellCommand(
          "python3 telemetry.py",
          6000
        );

      if (
        pyResult.exitCode ===
          0 &&
        pyResult.stdout
      ) {
        try {
          const parsed =
            JSON.parse(
              pyResult.stdout
            );

          return res.json(
            parsed
          );
        } catch {
          return res.json({
            raw:
              pyResult.stdout,

            source:
              "python3 telemetry.py",
          });
        }
      }

      return res.status(500).json({
        error:
          "Failed to execute python3 telemetry.py",

        details:
          pyResult.stderr,
      });
    } catch (err: any) {
      return res.status(500).json({
        error:
          err?.message ||
          "Python telemetry execution error",
      });
    }
  }
);

